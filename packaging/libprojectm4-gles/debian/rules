#!/usr/bin/make -f

# Private prefix: this is a GLES build that must not shadow a system
# libprojectM of the same SONAME, so it stays out of the linker's default path.
PREFIX := /usr/lib/milkdropper

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=$(PREFIX) \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DENABLE_GLES=ON \
		-DENABLE_PLAYLIST=ON \
		-DENABLE_SYSTEM_PROJECTM_EVAL=OFF \
		-DBUILD_SHARED_LIBS=ON \
		-DENABLE_SDL_UI=OFF \
		-DBUILD_TESTING=OFF

# The library lives outside the default search path on purpose, so do not
# generate shlibs references for it.
override_dh_makeshlibs:
	dh_makeshlibs --no-scripts

# ldconfig must not pick this up — that is the whole point of the private prefix.
override_dh_shlibdeps:
	dh_shlibdeps -l$(PREFIX)/lib
